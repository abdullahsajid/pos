<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pos.Pages.AddDealPage"
             Title="Add Deals"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="#FFF3EA"
            Shell.TitleColor="#753F21"
             BackgroundColor="#FFF3EA"
             xmlns:models="clr-namespace:pos.Models"
             xmlns:data="clr-namespace:pos.Data"
             xmlns:vm="clr-namespace:pos.ViewModels"
             xmlns:converters="clr-namespace:pos.Converters"
             x:DataType="vm:AddDealModel">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="txt" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="#FFF3EA" />
                <Setter Property="PlaceholderColor" Value="Black" />
            </Style>
            <Style x:Key="lbl" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="Black" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid ColumnDefinitions=".40*, .60*">
        <Grid Grid.Column="0" Margin="20" Padding="10" RowDefinitions="Auto,Auto, *, Auto" BackgroundColor="White">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Deal Image" FontAttributes="Bold" Style="{StaticResource lbl}"/>
                    <Grid ColumnDefinitions="Auto, *">
                        <Frame Grid.Column="0" 
                               Padding="0" 
                               HasShadow="False" 
                               BorderColor="#DDD0C8" 
                               HeightRequest="100" 
                               WidthRequest="100" 
                               CornerRadius="10"
                               IsClippedToBounds="True">
                             <Image Source="{Binding SelectedImageSource}" Aspect="AspectFill" />
                        </Frame>
                        <Button Grid.Column="1" 
                                Text="Select Image" 
                                Command="{Binding PickImageCommand}" 
                                Margin="10,0" 
                                VerticalOptions="Center"
                                BackgroundColor="#753F21"
                                TextColor="White"
                                CornerRadius="5"/>
                    </Grid>
                </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Spacing="15" Margin="0,15,0,0">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource lbl}" FontAttributes="Bold" Text="Name" TextColor="Black"/>
                        <Entry
                        Placeholder="Enter Deal Name"
                        PlaceholderColor="Black"
                        TextColor="Black"
                        Style="{StaticResource txt}"
                        Text="{Binding DealName}"
                    />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource lbl}" FontAttributes="Bold" Text="Product Key / Barcode" TextColor="Black"/>
                        <Entry
                        Placeholder="Enter Product Key"
                        PlaceholderColor="Black"
                        TextColor="Black"
                        Style="{StaticResource txt}"
                        Text="{Binding DealBarcode}"
                    />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource lbl}" FontAttributes="Bold" Text="Price" TextColor="Black"/>
                        <Entry
                        Placeholder="Enter Total Amount"
                        PlaceholderColor="Black"
                        TextColor="Black"
                        Style="{StaticResource txt}"
                        Keyboard="Numeric"
                        Text="{Binding Total}"
                        IsReadOnly="False"
                    />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                  ColumnDefinitions="*,*"
                  RowSpacing="15"
                  ColumnSpacing="10"
                  Padding="15">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Label Text="Item Name" FontAttributes="Bold" TextColor="Black"/>
                        <Entry Placeholder="Enter Item Name" 
                        PlaceholderColor="Black"
                        Style="{StaticResource txt}"
                        TextColor="Black"
                        Text="{Binding CurrentDeal.DealName}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="Item Price" FontAttributes="Bold" TextColor="Black"/>
                        <Entry Placeholder="0.00" 
                       PlaceholderColor="Black" 
                       TextColor="Black"
                       Style="{StaticResource txt}"
                       Keyboard="Numeric"
                       Text="{Binding CurrentDeal.UnitPrice}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="Item Quantity" FontAttributes="Bold" TextColor="Black"/>
                        <Entry Placeholder="1" 
                       PlaceholderColor="Black" 
                       Style="{StaticResource txt}"
                       TextColor="Black"
                       Keyboard="Numeric"
                       Text="{Binding CurrentDeal.Quantity}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                        <Button Text="Add to cart" 
                        BackgroundColor="#753F21" 
                        TextColor="White" 
                        CornerRadius="10" 
                        Grid.Column="1"
                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.AddDealItemCommand}"
                        CommandParameter="{Binding .}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                        <Button Text="Save" 
                        BackgroundColor="#753F21" 
                        TextColor="White" 
                        CornerRadius="10"
                        Grid.Column="0"
                        Command="{Binding SaveDealCommand}"
                        CommandParameter="{Binding .}"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,Auto" BackgroundColor="#A67B5B" Padding="10" Margin="0,15,0,0">
                <Label Text="Item Name" Grid.Column="0" TextColor="White" FontAttributes="Bold" FontSize="16" />
                <Label Text="Item Price" Grid.Column="1" TextColor="White" FontAttributes="Bold" FontSize="16" />
                <Label Text="Quantity" Grid.Column="2" TextColor="White" FontAttributes="Bold" FontSize="16" />
                <Label Text="SubTotal" Grid.Column="3" TextColor="White" FontAttributes="Bold" FontSize="16" />
            </Grid>

         
            <CollectionView 
            Grid.Row="3" 
            ItemsSource="{Binding DealItems}"
            HeightRequest="300"
            VerticalScrollBarVisibility="Always"
        >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:DealItem">
                        <Grid ColumnDefinitions="*,*,*,Auto" Padding="10" BackgroundColor="Transparent">
                            <Frame Grid.ColumnSpan="4" BackgroundColor="Transparent" BorderColor="#DDD0C8" Padding="0" Margin="0" HasShadow="False" />
                            <Entry Text="{Binding DealName}" Grid.Column="0" FontSize="16" BackgroundColor="Transparent" TextColor="Black" />
                            <Entry Text="{Binding UnitPrice}" Grid.Column="1" FontSize="16" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="Black" />
                            <Entry Text="{Binding Quantity}" Grid.Column="2" FontSize="16" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="Black" />
                            <Entry Text="{Binding SubTotal}" Grid.Column="3" FontSize="16" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="Black" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Grid Grid.Column="1" Margin="20"  RowDefinitions="Auto, Auto, *" RowSpacing="10">
            <Grid Grid.Row="1" ColumnDefinitions="60,*,*,*,Auto" BackgroundColor="#A67B5B" Padding="10" Margin="0,20,0,0">
                <Label Text="Img" Grid.Column="0" TextColor="White" FontAttributes="Bold" FontSize="16" />
                <Label Text="Deal Name" Grid.Column="1" TextColor="White" FontAttributes="Bold" FontSize="16" />
                <Label Text="Key" Grid.Column="2" TextColor="White" FontAttributes="Bold" FontSize="16" />
                <Label Text="Price (Rs)" Grid.Column="3" TextColor="White" FontAttributes="Bold" FontSize="16" />
                <Label Text="Actions" Grid.Column="4" TextColor="White" FontAttributes="Bold" FontSize="16" Margin="0,0,10,0"/>
            </Grid>
            <CollectionView Grid.Row="2" 
                                
                       ItemsSource="{Binding Deals}" 
                      >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:Deal">
                        <Grid ColumnDefinitions="60,*,*,*,Auto" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                            <Frame Grid.ColumnSpan="5" BackgroundColor="Transparent" BorderColor="#DDD0C8" Padding="0" Margin="0" HasShadow="False" />

                            <Border Grid.Column="0" HeightRequest="45" WidthRequest="45" StrokeShape="RoundRectangle 8" 
                                    BackgroundColor="#F8F9FA" Stroke="#DDD0C8" Padding="0" HorizontalOptions="Center">
                                <Grid>
                                    <Label Text="+" TextColor="#753F21" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20" />
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PickImageForUpdateCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <Entry Text="{Binding DealName}" Grid.Column="1" FontSize="16" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />

                            <Entry Text="{Binding Barcode}" Grid.Column="2" FontSize="16" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />

                            <Entry Text="{Binding DealAmount}" Grid.Column="3" FontSize="16" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="4" Spacing="5" HorizontalOptions="End" VerticalOptions="Center">
                                <Button
                                    Text="Update"
                                    BackgroundColor="Green"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UpdateDealCommand}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Text="Del"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDealCommand}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>