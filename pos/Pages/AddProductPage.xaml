<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pos.Pages.AddProductPage"
             Title="Add Items"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="#FFF3EA"
             Shell.TitleColor="#753F21"
             BackgroundColor="#FFF3EA"
             xmlns:models="clr-namespace:pos.Models"
             xmlns:data="clr-namespace:pos.Data"
             xmlns:vm="clr-namespace:pos.ViewModels"
             xmlns:converters="clr-namespace:pos.Converters"
             x:DataType="vm:AddProductModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="txt" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="#FFF3EA" />
                <Setter Property="PlaceholderColor" Value="Black" />
            </Style>
            <Style x:Key="lbl" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="Black" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>


    <Grid ColumnDefinitions=".40*, .60*">
        <Grid Grid.Column="0" Margin="20" Padding="10" BackgroundColor="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout>
                        <Label Text="Categories" Style="{StaticResource lbl}" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding AddProductCategory}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout
                                    HorizontalItemSpacing="3"
                                    Orientation="Vertical"
                                    Span="3"
                                    VerticalItemSpacing="3"
                                />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryModel">
                                    <Border 
                                        HeightRequest="40" 
                                        StrokeShape="RoundRectangle 10"
                                        Padding="20,10"
                                        StrokeThickness="2"
                                        BackgroundColor="#FFF3EA"
                                        Stroke="White"
                                     >
                                        <Label Text="{Binding Name}" TextColor="#753F21">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsSelected}"
                                                    TargetType="Label"
                                                    Value="True"
                                                >
                                                    <Setter Property="TextColor" Value="White"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Border.Triggers>
                                            <DataTrigger
                                                    Binding="{Binding IsSelected}" 
                                                    TargetType="Border"
                                                    Value="True"
                                            >
                                                <Setter Property="BackgroundColor" Value="#753F21"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProductsCategoryCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource lbl}" FontAttributes="Bold" Text="Name" TextColor="Black"/>
                        <Entry
                            Placeholder="Enter Name"
                            PlaceholderColor="Black"
                            TextColor="Black"
                            Style="{StaticResource txt}"
                            Text="{Binding CurrentProduct.Name}"
                        />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource lbl}" FontAttributes="Bold" Text="Product Key / Barcode" TextColor="Black"/>
                        <Entry
                            Placeholder="Enter Product Key"
                            PlaceholderColor="Black"
                            TextColor="Black"
                            Style="{StaticResource txt}"
                            Text="{Binding CurrentProduct.Barcode}"
                        />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource lbl}" FontAttributes="Bold" Text="Price" TextColor="Black"/>
                        <Entry
                            Placeholder="Enter Price"
                            PlaceholderColor="Black"
                            TextColor="Black"
                            
                            Keyboard="Numeric"
                            Text="{Binding CurrentProduct.Price}"
                        />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Descrption" FontAttributes="Bold" Style="{StaticResource lbl}"/>
                        <Editor
                            MinimumHeightRequest="100"
                            Placeholder="Enter Description"
                            PlaceholderColor="Black"
                            TextColor="Black"
                            Style="{StaticResource txt}"
                            Text="{Binding CurrentProduct.Description}"
                        />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Product Image" FontAttributes="Bold" Style="{StaticResource lbl}"/>
                        <Grid ColumnDefinitions="Auto, *">
                            <Frame Grid.Column="0" 
                                   Padding="0" 
                                   HasShadow="False" 
                                   BorderColor="#DDD0C8" 
                                   HeightRequest="100" 
                                   WidthRequest="100" 
                                   CornerRadius="10"
                                   IsClippedToBounds="True">
                                 <Image Source="{Binding SelectedImageSource}" Aspect="AspectFill" />
                            </Frame>
                            <Button Grid.Column="1" 
                                    Text="Select Image" 
                                    Command="{Binding PickImageCommand}" 
                                    Margin="10,0" 
                                    VerticalOptions="Center"
                                    BackgroundColor="#753F21"
                                    TextColor="White"
                                    CornerRadius="5"/>
                        </Grid>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*">
                        <Button
                            Grid.Column="1"
                            BackgroundColor="Green"    
                            Text="Save"
                            TextColor="White" 
                            Command="{Binding SaveProductCommand}"
                        />
                    </Grid>
                    <VerticalStackLayout Spacing="10" Margin="20">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource lbl}" FontAttributes="Bold" Text="Name" TextColor="Black"/>
                            <Entry
                                    Placeholder="Enter Category Name"
                                    PlaceholderColor="Black"
                                    TextColor="Black"
                                    Style="{StaticResource txt}"
                                    x:Name="categoryEntryField"
                                />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*">
                        <Button
                            Grid.Column="1"
                            BackgroundColor="Green"    
                            Text="Save"
                            TextColor="White" 
                            x:Name="saveButton"
                            Clicked="saveCategory_Clicked"
                        />
                    </Grid>
                     <VerticalStackLayout Spacing="10">
                        <CollectionView ItemsSource="{Binding MenuCategories}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" 
                                    Span="3"
                                    HorizontalItemSpacing="10" 
                                    VerticalItemSpacing="10"/>  
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="data:MenuCategory">
                                    <Border Padding="20,10"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#FFF3EA"
                                        Stroke="White">
                                        <VerticalStackLayout Spacing="10">
                                            <Entry 
                                               Text="{Binding Name}" 
                                               FontSize="16" 
                                               BackgroundColor="Transparent" 
                                               TextColor="Black" 
                                            /> 
                                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15" Margin="0,5">
                                                <!-- Custom Check Button -->
                                                <Border HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" BackgroundColor="Green" StrokeThickness="0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UpdateCategoriesCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="✓" TextColor="White" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                                </Border>

                                                <!-- Custom Delete Button -->
                                                <Border HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" BackgroundColor="#DC3545" StrokeThickness="0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCategoryCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="✕" TextColor="White" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <Grid Grid.Column="1" Margin="20"  RowDefinitions="Auto, Auto, *" RowSpacing="10">
            <CollectionView Grid.Row="0" ItemsSource="{Binding Categories}" HorizontalOptions="Center" HorizontalScrollBarVisibility="Default">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryModel">
                        <Border Padding="20,10"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#FFF3EA"
                            Stroke="White"
                            >
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" TextColor="#753F21">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsSelected}"
                                            TargetType="Label"
                                            Value="True"
                                        >
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected}" 
                                    TargetType="Border"
                                    Value="True"
                                >
                                    <Setter Property="BackgroundColor" Value="#753F21"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid Grid.Row="1" ColumnDefinitions="60,*,80,100,Auto" BackgroundColor="#A67B5B" Padding="10" Margin="0,20,0,0">
                    <Label Text="Img" Grid.Column="0" TextColor="White" FontAttributes="Bold" FontSize="14" />
                    <Label Text="Name" Grid.Column="1" TextColor="White" FontAttributes="Bold" FontSize="14" />
                    <Label Text="Key" Grid.Column="2" TextColor="White" FontAttributes="Bold" FontSize="14" />
                    <Label Text="Price" Grid.Column="3" TextColor="White" FontAttributes="Bold" FontSize="14" />
                    <Label Text="Actions" Grid.Column="4" TextColor="White" FontAttributes="Bold" FontSize="14" Margin="0,0,20,0"/>
            </Grid>
            <CollectionView Grid.Row="2" 
                                x:Name="ProductListView"
                       ItemsSource="{Binding Products}" 
                      >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:ProductItem">
                        <Grid ColumnDefinitions="60,*,80,100,Auto" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                            <Frame Grid.ColumnSpan="5" BackgroundColor="Transparent" BorderColor="#DDD0C8" Padding="0" Margin="0" HasShadow="False" />

                            <!-- Clickable Thumbnail for Update -->
                            <Border Grid.Column="0" HeightRequest="45" WidthRequest="45" StrokeShape="RoundRectangle 8" 
                                    BackgroundColor="#F8F9FA" Stroke="#DDD0C8" Padding="0" HorizontalOptions="Center">
                                <Grid>
                                    <Label Text="+" TextColor="#753F21" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20" />
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PickImageForUpdateCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <Entry Text="{Binding Name}" Grid.Column="1" FontSize="14" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />

                            <Entry Text="{Binding Barcode}" Grid.Column="2" FontSize="14" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />

                            <Entry Text="{Binding Price}" Grid.Column="3" FontSize="14" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="Black" VerticalOptions="Center" />
                            
                            <HorizontalStackLayout Grid.Column="4" Spacing="5" HorizontalOptions="End" VerticalOptions="Center">
                                <Button
                                    Text="Update"
                                    BackgroundColor="Green"
                                    TextColor="White"
                                    FontSize="12"
                                    HeightRequest="35"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UpdateItemCommand}"
                                    CommandParameter="{Binding .}"
                                />
                                <Button
                                    Text="Del"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    FontSize="12"
                                    HeightRequest="35"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductsCommand}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>