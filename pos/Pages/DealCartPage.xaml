<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pos.Pages.DealCartPage"
             Title="Deal Cart"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="#FFF3EA"
             Shell.TitleColor="#753F21"
             BackgroundColor="#FFF3EA"
             xmlns:data="clr-namespace:pos.Data"
             xmlns:models="clr-namespace:pos.Models"
             xmlns:vm="clr-namespace:pos.ViewModels"
             x:DataType="vm:DealCartModel"
             >
    <Grid ColumnDefinitions=".40*, .60*">
        <!-- Sidebar - Shopping Cart Section -->
        <Grid Grid.Column="0" Margin="20" RowDefinitions="Auto, Auto, *, Auto" BackgroundColor="White">
            <SearchBar 
                Grid.Row="0"
                Placeholder="Search items in cart..." 
                TextChanged="OnSearchDealItems"
                CancelButtonColor="Gray"
                PlaceholderColor="Gray"
                TextColor="Black"
                Margin="0,0,0,10" 
            />
            
            <VerticalStackLayout Grid.Row="1" Spacing="0">
                <Grid Padding="8" BackgroundColor="#753F21" ColumnDefinitions="*, 80, 80, 80, 40">
                    <Label Grid.Column="0" Text="Name" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Qty" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="Price" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    <Label Grid.Column="3" Text="Total" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" />
            </VerticalStackLayout>

            <!-- Cart Items List -->
            <ScrollView Grid.Row="2">
                <CollectionView ItemsSource="{Binding CartItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartModel">
                            <Grid Padding="10" ColumnDefinitions="*, 80, 80, 80, 40">
                                <Label Grid.Column="0" Text="{Binding Name}" TextColor="Black" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                                <Entry Grid.Column="1" Text="{Binding Quantity, Mode=TwoWay}" TextColor="Black" Keyboard="Numeric" HorizontalTextAlignment="Center" WidthRequest="50" HeightRequest="40" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding Price}" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                <Label Grid.Column="3" Text="{Binding Total}" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                <ImageButton Grid.Column="4" Source="cross.png" WidthRequest="25" HeightRequest="25" Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFromCartCommand}" CommandParameter="{Binding .}" VerticalOptions="Center"/>
                                <BoxView Grid.Row="1" Grid.ColumnSpan="5" HeightRequest="1" BackgroundColor="#E0E0E0" VerticalOptions="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <!-- Totals Section -->
            <Border Grid.Row="3" Padding="15" Margin="0,10,0,0" StrokeShape="RoundRectangle 10" Stroke="#E0E0E0">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="10">
                    <Label Text="Payment" FontSize="20" TextColor="Black" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
                    <Entry Text="{Binding Payment, Mode=TwoWay}" FontSize="20" TextColor="Black" Grid.Row="0" Grid.Column="1" WidthRequest="150" HorizontalTextAlignment="End" Keyboard="Numeric"/>
                    
                    <Label Text="Change" FontSize="20" TextColor="Black" Grid.Row="1" Grid.Column="0"/>
                    <Label Text="{Binding Change}" FontSize="20" TextColor="Black" Grid.Row="1" Grid.Column="1" HorizontalTextAlignment="End"/>
                    
                    <Label Text="Total" FontSize="22" FontAttributes="Bold" TextColor="Black" Grid.Row="2" Grid.Column="0"/>
                    <Label Text="{Binding Total, StringFormat='Rs {0:N0}'}" FontSize="22" FontAttributes="Bold" TextColor="#753F21" Grid.Row="2" Grid.Column="1" HorizontalTextAlignment="End"/>
                    
                    <Button Grid.Row="3" Grid.ColumnSpan="2" Text="PRINT INVOICE" BackgroundColor="Green" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Command="{Binding PrintInvoiceCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Side - Product Selection -->
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *" RowSpacing="10" Margin="0,20,20,20">
            <!-- Categories -->
            <CollectionView Grid.Row="0" ItemsSource="{Binding Categories}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryModel">
                        <Border Padding="20,10" StrokeShape="RoundRectangle 10" BackgroundColor="#FFF3EA" Stroke="#753F21">
                             <Border.Triggers>
                                 <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                     <Setter Property="BackgroundColor" Value="#753F21"/>
                                 </DataTrigger>
                             </Border.Triggers>
                             <Label Text="{Binding Name}" TextColor="#753F21">
                                 <Label.Triggers>
                                     <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                         <Setter Property="TextColor" Value="White"/>
                                     </DataTrigger>
                                 </Label.Triggers>
                             </Label>
                             <Border.GestureRecognizers>
                                 <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}" CommandParameter="{Binding .}"/>
                             </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <SearchBar Grid.Row="1" Placeholder="Search products..." TextChanged="OnSearchProductDealItems" BackgroundColor="White"/>

            <CollectionView Grid.Row="2" ItemsSource="{Binding ProductItem}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:ProductItem">
                        <Border Padding="15" StrokeShape="RoundRectangle 10" BackgroundColor="White" Stroke="#E0E0E0">
                            <Grid RowDefinitions="Auto, Auto, *" RowSpacing="5">
                                <Label Grid.Row="0" Text="{Binding Name}" TextColor="Black" FontSize="18" MaxLines="2" LineBreakMode="WordWrap"/>
                                <Label Grid.Row="1" Text="{Binding Price, StringFormat='Rs {0:N0}'}" FontSize="22" FontAttributes="Bold" TextColor="#753F21"/>
                                <Button Grid.Row="2" Text="Add to cart" BackgroundColor="#753F21" TextColor="White" HeightRequest="45" CornerRadius="10" VerticalOptions="End" Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToCartCommand}" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>