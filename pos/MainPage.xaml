<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pos.MainPage"
             Title="Items Cart"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="#FFF3EA"
             Shell.TitleColor="#753F21"
             BackgroundColor="#FFF3EA"
             xmlns:data="clr-namespace:pos.Data"
             xmlns:models="clr-namespace:pos.Models"
             xmlns:vm="clr-namespace:pos.ViewModels"
             xmlns:selectors="clr-namespace:pos.Selectors"
             xmlns:converters="clr-namespace:pos.Converters"
             x:DataType="vm:HomeViewModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToColorConverter x:Key="StringToColorConverter"/>
            <converters:SelectionConverter x:Key="SelectionConverter"/>
            <DataTemplate x:Key="ProductSearchTemplate" x:DataType="models:SearchItemModel">
                <Border Padding="10" Margin="2" StrokeThickness="2" BackgroundColor="White" StrokeShape="RoundRectangle 5">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="#FFE8D6" />
                            <Setter Property="Stroke" Value="#753F21" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="Stroke" Value="Transparent" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.AddToCartCommand}"
                            CommandParameter="{Binding Item}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                        <Label Grid.Column="0" Grid.Row="0" Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="Black"/>
                        <Label 
                            Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" 
                            Text="{Binding DisplayPrice, StringFormat='{0:C}'}" 
                            VerticalOptions="Center" TextColor="#753F21" FontAttributes="Bold"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="DealSearchTemplate" x:DataType="models:SearchItemModel">
                <Border Padding="10" Margin="2" StrokeThickness="2" BackgroundColor="White" StrokeShape="RoundRectangle 5">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="#FFE8D6" />
                            <Setter Property="Stroke" Value="#753F21" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="Stroke" Value="Transparent" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.AddToCartCommand}"
                            CommandParameter="{Binding Item}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                        <Label Grid.Column="0" Grid.Row="0" Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="Black"/>
                        <Label 
                            Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" 
                            Text="{Binding DisplayPrice, StringFormat='{0:C}'}" 
                            VerticalOptions="Center" TextColor="#753F21" FontAttributes="Bold"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <selectors:SearchDataTemplateSelector x:Key="SearchSelector"
                ProductTemplate="{StaticResource ProductSearchTemplate}"
                DealTemplate="{StaticResource DealSearchTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid ColumnDefinitions=".40*, .60*">
        <Grid Grid.Column="0" Margin="20" RowDefinitions="Auto, Auto, *, Auto" BackgroundColor="White">
            <SearchBar 
                x:Name="CartSearchBar"
                Grid.Row="0"
                Placeholder="Search items in cart..." 
                TextChanged="OnSearchTextChanged"
                SearchButtonPressed="OnSearchButtonPressed"
                CancelButtonColor="Gray"
                PlaceholderColor="Gray"
                TextColor="Black"
                Margin="0,0,0,10" 
            />


            <Frame Grid.Row="1" IsVisible="{Binding IsSearchActive}" Padding="10" ZIndex="999" BackgroundColor="#FAFAFA" BorderColor="#E0E0E0" Margin="0,0,0,10">
                <VerticalStackLayout Spacing="10">
                    <CollectionView x:Name="SearchResultsView" ItemsSource="{Binding ProductItems}" SelectionMode="Single" 
                                    SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                    ItemTemplate="{StaticResource SearchSelector}"
                            HeightRequest="200">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="1" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
            <!-- Responsive Cart Table Area -->
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <VerticalStackLayout WidthRequest="550">
                    <!-- Table Header -->
                    <Grid Padding="8" BackgroundColor="#753F21">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Text="Name" TextColor="White" FontAttributes="Bold" Padding="10" />
                        <Label Grid.Column="1" Text="Qty" TextColor="White" FontAttributes="Bold" Padding="10" />
                        <Label Grid.Column="2" Text="Price" TextColor="White" FontAttributes="Bold" Padding="10" />
                        <Label Grid.Column="3" Text="Total" TextColor="White" FontAttributes="Bold" Padding="10" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" />

                    <!-- Scrollable Items List -->
                    <CollectionView ItemsSource="{Binding CartItems}" VerticalOptions="Fill">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartModel">
                                <Grid Padding="20" RowSpacing="0" ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Label Grid.Column="0" Text="{Binding Name}" TextColor="Black" Padding="10" />
                                    
                                    <Entry Grid.Column="1"
                                           Text="{Binding Quantity, Mode=TwoWay}"
                                           TextColor="Black"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           WidthRequest="60" />
                                    
                                    <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:C}'}" TextColor="Black" HorizontalTextAlignment="Center" Padding="10" />
                                    
                                    <Label Grid.Column="3" Text="{Binding Total, StringFormat='{0:C}'}" TextColor="Black" HorizontalTextAlignment="End" Padding="10" />
                                    
                                    <Border Grid.Column="4"
                                            HeightRequest="24"
                                            WidthRequest="24"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#DC3545"
                                            StrokeThickness="0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            Margin="0,0,10,0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={x:Reference ProductListView}, Path=BindingContext.RemoveFromCartCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="✕" TextColor="White" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                    </Border>

                                    <BoxView Grid.ColumnSpan="5" HeightRequest="1" BackgroundColor="#E0E0E0" VerticalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
            <VerticalStackLayout Grid.Row="3">
                <HorizontalStackLayout Spacing="10" Margin="10,0" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 5" Padding="15,8" StrokeThickness="1">
                        <Label Text="Dine-In" TextColor="{Binding SelectedOrderType, Converter={StaticResource StringToColorConverter}, ConverterParameter='Dine-In'}"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectOrderTypeCommand}" CommandParameter="Dine-In"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedOrderType}" Value="Dine-In">
                                <Setter Property="BackgroundColor" Value="#753F21"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                    <Border StrokeShape="RoundRectangle 5" Padding="15,8" StrokeThickness="1">
                        <Label Text="Parcel" TextColor="{Binding SelectedOrderType, Converter={StaticResource StringToColorConverter}, ConverterParameter='Parcel'}"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectOrderTypeCommand}" CommandParameter="Parcel"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedOrderType}" Value="Parcel">
                                <Setter Property="BackgroundColor" Value="#753F21"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </HorizontalStackLayout>
                <Border Padding="5, 10" Margin="10" StrokeShape="RoundRectangle 10">
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                        ColumnDefinitions="2*, 3*">
                        <Label 
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Payment" 
                            FontSize="20"
                            TextColor="#753F21"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                        />
                        <Entry
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="20"
                            Text="{Binding Payment, Mode=TwoWay}"
                            Keyboard="Numeric"
                            HorizontalTextAlignment="End"
                            TextColor="Black"
                            BackgroundColor="#F8F8F8"
                            Margin="0,5"
                        />
                        <Label 
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Discount" 
                            FontSize="20"
                            TextColor="#753F21"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                        />
                        <Entry
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="20"
                            Text="{Binding DiscountText, Mode=TwoWay}"
                            Keyboard="Numeric"
                            HorizontalTextAlignment="End"
                            TextColor="DarkRed"
                            BackgroundColor="#F8F8F8"
                            Margin="0,5"
                        />
                        <Label 
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Change" 
                            FontSize="18"
                            TextColor="Gray"
                            VerticalOptions="Center"
                        />
                        <Label 
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="18"
                            Text="{Binding Change, StringFormat='Rs {0:N2}'}" 
                            TextColor="Gray" 
                            HorizontalTextAlignment="End"
                            VerticalOptions="Center"
                        />
                        <Label 
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="TOTAL" 
                            FontSize="24"
                            TextColor="#753F21"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                        />
                        <Label 
                            Grid.Row="3"
                            Grid.Column="1"
                            FontSize="26"
                            Text="{Binding Total, StringFormat='Rs {0:N2}'}" 
                            TextColor="Black" 
                            HorizontalTextAlignment="End"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                        />
                        <Button 
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0"
                            Text="PRINT RECEIPT" 
                            BackgroundColor="#753F21" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="10" 
                            HeightRequest="50"
                            Command="{Binding PrintInvoiceCommand}"
                            CommandParameter="{Binding .}"
                        />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, *" RowSpacing="10">
            <CollectionView Grid.Row="1" x:Name="CategoryListView" ItemsSource="{Binding Categories}" HorizontalOptions="Center" HorizontalScrollBarVisibility="Default">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryModel">
                        <Border Padding="20,10"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#FFF3EA"
                                Stroke="White"
                                >
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" TextColor="#753F21">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsSelected}"
                                            TargetType="Label"
                                            Value="True"
                                        >
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected}" 
                                    TargetType="Border"
                                    Value="True"
                                >
                                    <Setter Property="BackgroundColor" Value="#753F21"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <SearchBar 
                Grid.Row="2"
                Placeholder="Search items..." 
                TextChanged="OnSearchProductItems"
                CancelButtonColor="Gray"
                PlaceholderColor="Gray"
                TextColor="Black"
                Margin="0,0,0,10" 
                BackgroundColor="#FFF"
            />
            <Grid Grid.Row="3" RowSpacing="0">
                <CollectionView x:Name="ProductListView" ItemsSource="{Binding Products}" IsVisible="{Binding HasProducts}" VerticalOptions="Fill">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:ProductItem">
                            <Border Padding="15"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="White"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    >
                                <Grid RowDefinitions="120, Auto, Auto, *" RowSpacing="5">
                                    <Image Grid.Row="0" 
                                           Source="{Binding ImagePath}" 
                                           Aspect="AspectFill" 
                                           HeightRequest="120"
                                           VerticalOptions="Start"
                                           Margin="-15,-15,-15,0" /> <!-- Bleed image to edges -->
                                    <Label Grid.Row="1" Text="{Binding Name}" TextColor="Black" FontSize="16" FontAttributes="Bold" LineBreakMode="WordWrap" MaxLines="2" Margin="0,5,0,0"/>
                                    <Label Grid.Row="2" Text="{Binding Price, StringFormat='Rs {0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="#753F21"/>
                                    <Button Grid.Row="3" Text="Add to cart" 
                                        BackgroundColor="#753F21" 
                                        TextColor="White" 
                                        CornerRadius="10" 
                                        VerticalOptions="End"
                                        HeightRequest="36"
                                        Padding="0"
                                        FontSize="12"
                                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <CollectionView ItemsSource="{Binding Deals}" IsVisible="{Binding HasDeals}" VerticalOptions="Fill">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:Deal">
                            <Border Padding="15"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="White"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    >
                                <Grid RowDefinitions="120, Auto, Auto, *" RowSpacing="5">
                                    <Image Grid.Row="0" 
                                           Source="{Binding ImagePath}" 
                                           Aspect="AspectFill" 
                                           HeightRequest="120"
                                           VerticalOptions="Start"
                                           Margin="-15,-15,-15,0" />
                                    
                                    <Label Grid.Row="1" Text="{Binding DealName}" TextColor="Black" FontSize="16" FontAttributes="Bold" LineBreakMode="WordWrap" MaxLines="2" Margin="0,5,0,0"/>
                                    <Label Grid.Row="2" Text="{Binding DealAmount, StringFormat='Rs {0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="#753F21"/>
                                    
                                    <Button Grid.Row="3" Text="Add to cart" 
                                        BackgroundColor="#753F21" 
                                        TextColor="White" 
                                        CornerRadius="10" 
                                        VerticalOptions="End"
                                        HeightRequest="36"
                                        Padding="0"
                                        FontSize="12"
                                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}} ,Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>            
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>