<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="pos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:pos"
    xmlns:pages="clr-namespace:pos.Pages"
    Shell.FlyoutBackgroundColor="White"
    Shell.FlyoutWidth="180"
    Title="pos">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="50" Padding="20,0">
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <!-- Icon Slot (using standard Icon binding) -->
                    <Image Source="{Binding Icon}"
                           HeightRequest="22"
                           WidthRequest="22"
                           VerticalOptions="Center" />
                    
                    <!-- Text: Explicitly Black for visibility on White background -->
                    <Label Text="{Binding Title}"
                           TextColor="Black"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Home" Icon="home">
        <ShellContent
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Product" Icon="add_items">
        <ShellContent
            ContentTemplate="{DataTemplate pages:AddProductPage}"
            Route="AddProductPage" />
    </FlyoutItem>

    <FlyoutItem Title="Order" Icon="clipboard">
        <ShellContent
            ContentTemplate="{DataTemplate pages:OrderPage}"
            Route="OrderPage" />
    </FlyoutItem>

    <FlyoutItem Title="Deal Cart" Icon="add_to_cart">
        <ShellContent
            ContentTemplate="{DataTemplate pages:DealCartPage}"
            Route="DealCartPage" />
    </FlyoutItem>

    <FlyoutItem Title="Deals" Icon="grid">
        <ShellContent
            ContentTemplate="{DataTemplate pages:AddDealPage}"
            Route="AddDealPage" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="settings">
        <ShellContent
            ContentTemplate="{DataTemplate pages:SettingPage}"
            Route="SettingPage" />
    </FlyoutItem>

</Shell>